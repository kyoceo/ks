--========================================================--
-- VOID & RECOVERY SYSTEM
--========================================================--

voidReset = function()
	local character = player.Character
	if not character then return end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.CFrame = hrp.CFrame - Vector3.new(0, 500, 0)
	end
end

local function setupRagdollReset(character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then return end
	task.wait(1)

	local hasReset = false
	local function doRagdollRecovery()
		if hasReset or isExecutingVoidCycle then return end
		hasReset = true
		
		if (mode == "attack" and attackTarget) or (killAllRunning and attackTarget) then
			local currentTarget = attackTarget
			stopFollowing()
			isExecutingVoidCycle = true
			
			task.spawn(function()
				attackSequenceSessionID = attackSequenceSessionID + 1
				local currentSession = attackSequenceSessionID

				local myChar = player.Character
				if myChar and myChar:FindFirstChild("Humanoid") then
					myChar.Humanoid.Health = 0
				end
				
				for i = 1, 5 do
					local respawnedChar = player.CharacterAdded:Wait()
					respawnedChar:WaitForChild("HumanoidRootPart", 5)
					task.wait(0.3)
					voidReset()
				end
				task.wait(0.3)
				
				isExecutingVoidCycle = false
				
				if currentTarget and currentTarget.Parent and attackSequenceSessionID == currentSession then
					FLOAT_HEIGHT = savedHeightTracker
					mode = "attack"
					attackTarget = currentTarget
					startFollowing()
				end
			end)
		end
	end

	humanoid:GetPropertyChangedSignal("PlatformStand"):Connect(function()
		if humanoid.PlatformStand then doRagdollRecovery() end
	end)

	humanoid.StateChanged:Connect(function(_, newState)
		if newState == Enum.HumanoidStateType.Ragdoll or newState == Enum.HumanoidStateType.Physics then
			doRagdollRecovery()
		end
	end)
end

if player.Character then
	task.spawn(setupRagdollReset, player.Character)
end
player.CharacterAdded:Connect(setupRagdollReset)

