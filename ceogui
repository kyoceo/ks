local function findPlayerByFuzzy(str)
	if not str or str == "" then return nil end
	str = str:lower()
	local bestMatch = nil
	local shortestLength = 999
	
	for _, plr in ipairs(Players:GetPlayers()) do
		local name = plr.Name:lower()
		local disp = plr.DisplayName:lower()
		if name:find(str) or disp:find(str) then
			local len = math.min(#name, #disp)
			if len < shortestLength then
				shortestLength = len
				bestMatch = plr
			end
		end
	end
	return bestMatch
end

local function updateHitboxes(dt)
	for _, plr in ipairs(Players:GetPlayers()) do
		local char = plr.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			local hrp = char.HumanoidRootPart
			
			-- 1. Outer outline set to 100% visible (SurfaceTransparency = 0)
			local selectionBox = hrp:FindFirstChild("KHitboxOutline")
			if not selectionBox then
				selectionBox = Instance.new("SelectionBox")
				selectionBox.Name = "KHitboxOutline"
				selectionBox.LineThickness = 0.12
				selectionBox.Parent = hrp
			end
			selectionBox.SurfaceTransparency = 0 -- 100% visible solid outline

			-- 2. Inside box set to clearly visible high-contrast (Transparency = 0.2, meaning 80% opaque/visible)
			local insideBox = hrp:FindFirstChild("KHitboxInside")
			if not insideBox then
				insideBox = Instance.new("BoxHandleAdornment")
				insideBox.Name = "KHitboxInside"
				insideBox.AlwaysOnTop = true
				insideBox.ZIndex = 5
				insideBox.Parent = hrp
			end

			if immunePlayers[plr] or plr == parentPlayer or assigners[plr.Name] then
				selectionBox.Adornee = nil
				insideBox.Adornee = nil
			else
				selectionBox.Adornee = hrp
				selectionBox.Color3 = Color3.fromRGB(0, 150, 255)

				insideBox.Adornee = hrp
				insideBox.Size = Vector3.new(HITBOX_SIZE, HITBOX_SIZE, HITBOX_SIZE)
				insideBox.Color3 = SOLO_COLOR
				insideBox.Transparency = 0.2 -- Much higher contrast/visibility so you can clearly see it
				
				hrp.Size = Vector3.new(HITBOX_SIZE, HITBOX_SIZE, HITBOX_SIZE)
				hrp.Transparency = 1
			end
		end
	end
end

local function smoothMove(hrp, targetPos, stepSize)
	local dir = targetPos - hrp.Position
	local mag = dir.Magnitude
	if mag < 0.01 then return end
	dir = dir.Unit
	local step = math.min(stepSize, mag)
	local newPos = hrp.Position + dir * (step + 0.15)
	newPos = Vector3.new(newPos.X, targetPos.Y, newPos.Z)
	hrp.CFrame = CFrame.new(newPos)
end

local function getPredictedPosition(targetHRP)
	if not PREDICT_ENABLED then return targetHRP.Position end
	return targetHRP.Position + (targetHRP.Velocity * PREDICT_FACTOR)
end

--========================================================--
-- ATTACK SEQUENCE
--========================================================--

runAttackSequence = function(target)
	if not target then return end
	
	attackSequenceSessionID = attackSequenceSessionID + 1
	local currentSession = attackSequenceSessionID

	isExecutingVoidCycle = true
	isApproachingTarget = true
	bKeyTriggered = false
	mode = "attack"
	attackTarget = target
	
	setupTargetHealthListener(target)

	if followConnection then 
		followConnection:Disconnect() 
		followConnection = nil
	end

	task.spawn(function()
		local myChar = player.Character
		if myChar and myChar:FindFirstChild("Humanoid") then
			myChar.Humanoid.Health = 0
		end

		for i = 1, 5 do
			local respawnedChar = player.CharacterAdded:Wait()
			respawnedChar:WaitForChild("HumanoidRootPart", 5)
			if attackSequenceSessionID ~= currentSession then return end
			task.wait(0.3)
			voidReset()
		end
		task.wait(0.3)

		if attackSequenceSessionID ~= currentSession then return end

		isExecutingVoidCycle = false
		FLOAT_HEIGHT = savedHeightTracker
		mode = "attack"
		attackTarget = target
		setupTargetHealthListener(target)
		startFollowing()
	end)
end

--========================================================--
-- KILL ALL
--========================================================--

startKillAll = function()
	stopFollowing()
	killAllRunning = true
	killAllSessionID = killAllSessionID + 1
	local currentKillSession = killAllSessionID

	task.spawn(function()
		while killAllRunning and killAllSessionID == currentKillSession do
			local eligiblePlayers = {}
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= player and not assigners[plr.Name] and not immunePlayers[plr] then
					table.insert(eligiblePlayers, plr)
				end
			end

			table.sort(eligiblePlayers, function(a, b)
				return a.Name:lower() < b.Name:lower()
			end)

			if #eligiblePlayers == 0 then
				killAllRunning = false
				mode = "idle"
				startFollowing()
				break
			end

			local index = 1
			while index <= #eligiblePlayers and killAllRunning and killAllSessionID == currentKillSession do
				local targetPlr = eligiblePlayers[index]

				if not targetPlr or not targetPlr.Parent then
					index = index + 1
					continue
				end

				isExecutingVoidCycle = false
				isApproachingTarget = true
				mode = "attack"
				attackTarget = targetPlr
				
				if followConnection then 
					followConnection:Disconnect() 
					followConnection = nil
				end

				local myChar = player.Character
				if myChar and myChar:FindFirstChild("Humanoid") then
					myChar.Humanoid.Health = 0
				end

				for i = 1, 5 do
					local respawnedChar = player.CharacterAdded:Wait()
					respawnedChar:WaitForChild("HumanoidRootPart", 5)
					if not killAllRunning or killAllSessionID ~= currentKillSession then break end
					task.wait(0.2)
					voidReset()
				end
				task.wait(0.2)

				if targetPlr and targetPlr.Parent and killAllRunning and killAllSessionID == currentKillSession then
					FLOAT_HEIGHT = savedHeightTracker
					mode = "attack"
					attackTarget = targetPlr
					startFollowing()
				end

				local targetSkipped = false
				while killAllRunning and killAllSessionID == currentKillSession do
					if not targetPlr or not targetPlr.Parent then
						targetSkipped = true
						break
					end

					local tChar = targetPlr.Character
					local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
					
					if not tChar or not tHum then
						break
					end
					
					local hp = tHum.Health
					if hp <= 0 or (hp >= 1 and hp <= 4) then
						targetSkipped = true
						break
					end
					
					task.wait(0.05)
				end

				stopFollowing()
				task.wait(0.2)
				
				index = index + 1
			end
			
			task.wait(0.5) 
		end
		killAllRunning = false
	end)
end

--========================================================--
-- DESTROY SYSTEM
--========================================================--

local function getTargetPosition(target)
	if target and target.Character then
		local hrp = target.Character:FindFirstChild("HumanoidRootPart")
		if hrp then return hrp.Position end
	end
	return nil
end

local function destroyTargetPlayer(dt)
	if not destroyTarget then return end
	local char = player.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local pos = getTargetPosition(destroyTarget)
	if not hrp or not pos then return end

	orbitAngle = orbitAngle + (ORBIT_SPEED * dt)
	local offset = Vector3.new(math.cos(orbitAngle)*ORBIT_RADIUS, FLOAT_HEIGHT, math.sin(orbitAngle)*ORBIT_RADIUS)
	smoothMove(hrp, pos + offset, MOVE_STEP)

	pcall(function()
		for i=1,2 do
			ReplicatedStorage.CombatRemote:FireServer("M1")
			task.wait(0.03)
			ReplicatedStorage.CombatRemote:FireServer("M2")
			task.wait(0.03)
		end
		if BLOCK_ENABLED then ReplicatedStorage.CombatRemote:FireServer("Block") end
	end)
end

--========================================================--
-- FOLLOW LOOP
--========================================================--

local lastTick = tick()
startFollowing = function()
	if followConnection then followConnection:Disconnect() end
	followConnection = RunService.Heartbeat:Connect(function()
		if panicMode or isExecutingVoidCycle then return end

		local now = tick()
		local dt = now - lastTick
		lastTick = now

		local char = player.Character
		if not char then return end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		updateHitboxes(dt)

		if mode == "destroy" and destroyTarget then
			destroyTargetPlayer(dt)
			task.wait(DESTROY_SPEED)
			return
		end

		if mode == "attack" and attackTarget then
			local tChar = attackTarget.Character
			if tChar and tChar:FindFirstChild("HumanoidRootPart") then
				local humanoid = tChar:FindFirstChildOfClass("Humanoid")
				
				if humanoid and not killAllRunning and not bKeyTriggered then
					local hp = humanoid.Health
					if hp >= 1 and hp <= 4 then
						bKeyTriggered = true
						FLOAT_HEIGHT = 0
						task.spawn(function()
							task.wait(2)
							VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.B, false, game)
							task.wait(0.05)
							VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.B, false, game)
						end)
					end
				end

				local targetHRP = tChar.HumanoidRootPart
				local predicted = getPredictedPosition(targetHRP)
				local pos = predicted + Vector3.new(0, FLOAT_HEIGHT, 0)
				
				local distance = (hrp.Position - targetHRP.Position).Magnitude
				local currentStep = isApproachingTarget and 1000 or 30
				if isApproachingTarget and distance <= (HITBOX_SIZE / 2) then
					isApproachingTarget = false
				end

				smoothMove(hrp, pos, currentStep)

				pcall(function()
					if not M1_ENABLED then
						ReplicatedStorage.CombatRemote:FireServer("M1")
						m1Count = m1Count + 1
						task.wait(0.05)
						if m1Count >= 5 then
							ReplicatedStorage.CombatRemote:FireServer("M2")
							m1Count = 0
						end
					end
					if BLOCK_ENABLED then ReplicatedStorage.CombatRemote:FireServer("Block") end
				end)
			end
			return
		end

		if mode == "idle" and parentPlayer.Character then
			local pHRP = parentPlayer.Character:FindFirstChild("HumanoidRootPart")
			if pHRP then
				smoothMove(hrp, pHRP.Position + Vector3.new(0, FLOAT_HEIGHT, 4), 30)
			end
		end
	end)
end

stopFollowing = function()
	if not killAllRunning then
		killAllSessionID = killAllSessionID + 1
	end
	attackSequenceSessionID = attackSequenceSessionID + 1
	isExecutingVoidCycle = false

	if followConnection then followConnection:Disconnect() end
	followConnection = nil
	if targetHealthConnection then targetHealthConnection:Disconnect() end
	targetHealthConnection = nil
	if targetAddedConnection then targetAddedConnection:Disconnect() end
	targetAddedConnection = nil
	
	if not killAllRunning then
		mode = "stop"
		attackTarget = nil
		destroyTarget = nil
	end
	ORBIT_SPEED = savedOrbitSpeed
end

--========================================================--
-- HEALTH & DEATH LISTENER
--========================================================--

setupTargetHealthListener = function(target)
	if targetHealthConnection then targetHealthConnection:Disconnect() end
	if targetAddedConnection then targetAddedConnection:Disconnect() end
	
	local function monitorCharacter(char)
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if humanoid then
			targetHealthConnection = humanoid.Died:Connect(function()
				if mode == "attack" and attackTarget == target and not isExecutingVoidCycle and not killAllRunning then
					runAttackSequence(target)
				end
			end)
		end
	end

	if target.Character then monitorCharacter(target.Character) end
	targetAddedConnection = target.CharacterAdded:Connect(function(char)
		task.wait(0.5)
		if mode == "attack" and attackTarget == target and not isExecutingVoidCycle and not killAllRunning then
			monitorCharacter(char)
		end
	end)
end

--========================================================--
-- COMMAND HANDLER & CHAT INTERFACE
--========================================================--

local function runCommand(cmd)
	if cmd.type=="idle" then
		stopFollowing()
		killAllRunning = false
		mode="idle"
		isApproachingTarget = true
		startFollowing()
	elseif cmd.type=="attack" and cmd.target then
		killAllRunning = false
		runAttackSequence(cmd.target)
	elseif cmd.type=="killall" then
		startKillAll()
	elseif cmd.type=="destroy" and cmd.target then
		stopFollowing()
		killAllRunning = false
		savedOrbitSpeed = ORBIT_SPEED
		ORBIT_SPEED = 200
		mode="destroy"
		destroyTarget = cmd.target
		isApproachingTarget = true
		startFollowing()
	elseif cmd.type=="stop" then
		killAllRunning = false
		stopFollowing()
	elseif cmd.type=="height" then
		FLOAT_HEIGHT = cmd.val
		savedHeightTracker = cmd.val
	elseif cmd.type=="immune" and cmd.target then
		immunePlayers[cmd.target] = true
		updateImmuneChecklistUI()
	elseif cmd.type=="unimmune" and cmd.target then
		immunePlayers[cmd.target] = nil
		updateImmuneChecklistUI()
	elseif cmd.type=="block" then
		BLOCK_ENABLED = cmd.val
	elseif cmd.type=="m1" then
		M1_ENABLED = cmd.val
		if M1_ENABLED and not m1LoopRunning then
			m1LoopRunning = true
			task.spawn(function()
				local CombatRemote = ReplicatedStorage:WaitForChild("CombatRemote")
				while M1_ENABLED do
					CombatRemote:FireServer("M1")
					task.wait(0)
				end
				m1LoopRunning = false
			end)
		end
	elseif cmd.type=="reset" then
		if not resetUsed then
			resetUsed = true
			local char = player.Character
			if char and char:FindFirstChild("Humanoid") then char.Humanoid.Health = 0 end
		end
	elseif cmd.type=="predict" then
		PREDICT_ENABLED = cmd.val
	elseif cmd.type=="loopkill" and cmd.target then
		killAllRunning = false
		runAttackSequence(cmd.target)
	elseif cmd.type=="unloopkill" then
		killAllRunning = false
		stopFollowing()
		mode="idle"
		isApproachingTarget = true
		startFollowing()
	end
end

local function processChat(plr, msg)
	local m = msg:lower()
	if assigners[plr.Name] then
		local t = m:match("^k%s+(.-)%s+controll$")
		if t then
			local found = findPlayerByFuzzy(t)
			if found then parentPlayer = found end
			return
		end
	end

	if plr ~= parentPlayer then return end

	if m == "k idle" then runCommand({type="idle"}) end
	if m == "k stop" then runCommand({type="stop"}) end
	if m == "k killall" then runCommand({type="killall"}) end

	local a = m:match("^k attack%s+(.+)$")
	if a then
		local found = findPlayerByFuzzy(a)
		if found then runCommand({type="attack", target=found}) end
	end

	local h = m:match("^k height%s+(%d+)$")
	if h then runCommand({type="height", val=tonumber(h)}) end

	local im = m:match("^k immune%s+(.+)$")
	if im then
		local found = findPlayerByFuzzy(im)
		if found then runCommand({type="immune", target=found}) end
	end

	local uim = m:match("^k unimmune%s+(.+)$")
	if uim then
		local found = findPlayerByFuzzy(uim)
		if found then runCommand({type="unimmune", target=found}) end
	end

	if m == "k block on" then runCommand({type="block", val=true}) end
	if m == "k block off" then runCommand({type="block", val=false}) end
	if m == "k m1 on" then runCommand({type="m1", val=true}) end
	if m == "k m1 off" then runCommand({type="m1", val=false}) end

	if m == "k reset" then
		resetUsed = false
		runCommand({type="reset"})
	end

	if m == "k predict on" then runCommand({type="predict", val=true}) end
	if m == "k predict off" then runCommand({type="predict", val=false}) end

	local lk = m:match("^k loopkill%s+(.+)$")
	if lk then
		local found = findPlayerByFuzzy(lk)
		if found then runCommand({type="loopkill", target=found}) end
	end
	if m == "k unloopkill" then runCommand({type="unloopkill"}) end

	local d = m:match("^k destroy%s+(.+)$")
	if d then
		local found = findPlayerByFuzzy(d)
		if found then runCommand({type="destroy", val=true, target=found}) end
	end
	if m == "k destroy off" then stopFollowing() end
end

local function bindPlayerChat(p)
	p.Chatted:Connect(function(msg) processChat(p, msg) end)
end

for _, p in ipairs(Players:GetPlayers()) do bindPlayerChat(p) end
Players.PlayerAdded:Connect(bindPlayerChat)

