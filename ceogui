local function createRow(name, defaultVal, isFloat, callback)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 14)
	label.Position = UDim2.new(0, 0, 0, yOffset)
	label.BackgroundTransparency = 1
	label.Text = name .. ": " .. tostring(defaultVal)
	label.TextColor3 = Color3.fromRGB(200, 200, 200)
	label.TextSize = 9
	label.Font = Enum.Font.SourceSans
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = scrollContainer
	yOffset = yOffset + 14

	local btnMinus = Instance.new("TextButton")
	btnMinus.Size = UDim2.new(0, 20, 0, 18)
	btnMinus.Position = UDim2.new(0, 0, 0, yOffset)
	btnMinus.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	btnMinus.Text = "-"
	btnMinus.TextColor3 = Color3.fromRGB(255, 255, 255)
	btnMinus.TextSize = 10
	btnMinus.Parent = scrollContainer

	local btnPlus = Instance.new("TextButton")
	btnPlus.Size = UDim2.new(0, 20, 0, 18)
	btnPlus.Position = UDim2.new(0, 22, 0, yOffset)
	btnPlus.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	btnPlus.Text = "+"
	btnPlus.TextColor3 = Color3.fromRGB(255, 255, 255)
	btnPlus.TextSize = 10
	btnPlus.Parent = scrollContainer

	local valBox = Instance.new("TextBox")
	valBox.Size = UDim2.new(0, 68, 0, 18)
	valBox.Position = UDim2.new(0, 44, 0, yOffset)
	valBox.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
	valBox.Text = tostring(defaultVal)
	valBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	valBox.TextSize = 9
	valBox.Font = Enum.Font.SourceSans
	valBox.ClearTextOnFocus = false
	valBox.Parent = scrollContainer
	Instance.new("UICorner", valBox).CornerRadius = UDim.new(0, 3)

	local currentVal = defaultVal
	local function update(val)
		currentVal = val
		if isFloat then
			valBox.Text = string.format("%.2f", currentVal)
			label.Text = name .. ": " .. string.format("%.2f", currentVal)
		else
			valBox.Text = tostring(currentVal)
			label.Text = name .. ": " .. tostring(currentVal)
		end
		callback(currentVal)
	end

	btnMinus.MouseButton1Click:Connect(function()
		if isFloat then update(math.max(0, currentVal - 0.01)) else update(currentVal - 1) end
	end)
	btnPlus.MouseButton1Click:Connect(function()
		if isFloat then update(currentVal + 0.01) else update(currentVal + 1) end
	end)
	valBox.FocusLost:Connect(function()
		local num = tonumber(valBox.Text)
		if num then update(num) else update(currentVal) end
	end)

	yOffset = yOffset + 23
end

