	-- Place this LocalScript directly inside your ToggleButton
	--[====================================================================]
	
	local button = script.Parent
	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local LocalPlayer = Players.LocalPlayer
	
	-- Change this to the exact name of the item you want to auto-equip
	local WEAPON_NAME = "RustyPipe"
	
	local isRunning = false
	local equipThread = nil
	local respawnConnection = nil
	
	-- Set initial default state when the GUI loads
	button.Text = "Start Auto-Equip"
	button.BackgroundColor3 = Color3.fromRGB(0, 200, 0) -- Green
	
	local function findEquipRemote()
		for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
			if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
				local lowerName = string.lower(obj.Name)
				if lowerName:find("equip") or lowerName:find("inventory") or lowerName:find("use") then
					return obj
				end
			end
		end
		return nil
	end
	
	local function autoEquip()
		local inventory = LocalPlayer:WaitForChild("Inventory", 5)
		if not inventory then return end
	
		local itemVal = inventory:FindFirstChild(WEAPON_NAME)
		if itemVal then
			local equipRemote = findEquipRemote()
	
			if equipRemote then
				if equipRemote:IsA("RemoteEvent") then
					equipRemote:FireServer(WEAPON_NAME)
				elseif equipRemote:IsA("RemoteFunction") then
					equipRemote:InvokeServer(WEAPON_NAME)
				end
				print("[Auto-Equip] Successfully triggered equip for: " .. WEAPON_NAME)
			else
				warn("[Auto-Equip] Could not automatically find the Equip RemoteEvent.")
			end
		end
	end
	
	--[MARKING: TOGGLE BUTTON CLICK EVENT]
	button.MouseButton1Click:Connect(function()
		isRunning = not isRunning -- Toggle the state
	
		if isRunning then
			-- ==========================================================
			-- [MARKING: START STATE]
			-- ==========================================================
			button.Text = "Stop Auto-Equip"
			button.BackgroundColor3 = Color3.fromRGB(200, 0, 0) -- Red
			print("[Auto-Equip]: Status -> STARTED")
	
			-- Run immediately when turned on
			autoEquip()
	
			-- Automatically run every time your character respawns while active
			respawnConnection = LocalPlayer.CharacterAdded:Connect(function(char)
				char:WaitForChild("HumanoidRootPart", 5)
				task.wait() 
				if isRunning then
					autoEquip()
				end
			end)
		else
			-- ==========================================================
			-- [MARKING: STOP STATE]
			-- ==========================================================
			button.Text = "Start Auto-Equip"
			button.BackgroundColor3 = Color3.fromRGB(0, 200, 0) -- Green
			print("[Auto-Equip]: Status -> STOPPED")
	
			-- Disconnect respawn event so it stops triggering when toggled off
			if respawnConnection then
				respawnConnection:Disconnect()
				respawnConnection = nil
			end
		end
	end)
