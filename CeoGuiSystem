	local matchedPlayer = findMatchingPlayer(PlayerNameInput.Text)
	if not matchedPlayer then
		warn("No matching player found!")
		return
	end
	customPlayerSizes[matchedPlayer] = 2
	print(matchedPlayer.Name .. " is now immune.")
	updateHitboxes()
end)

