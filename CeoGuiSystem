	local function findMatchingPlayer(searchTerm)
		if searchTerm == "" or searchTerm == "Immune" then return nil end
		searchTerm = searchTerm:lower()
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				if p.Name:lower():find(searchTerm, 1, true) or p.DisplayName:lower():find(searchTerm, 1, true) then
					return p
				end
			end
		end
		return nil
	end

