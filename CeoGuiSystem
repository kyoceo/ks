local function CDQQ_fake_script() -- AutoVoidButton.AutoVoidScript 
	local script = Instance.new('LocalScript', AutoVoidButton)

	--[====================================================================]
	-- DYNAMIC AUTO-VOID SCRIPT (SAFE / DEBUG VERSION)
	-- Place this LocalScript inside AutoVoidButton
	--====================================================================]
	
	local Players = game:GetService("Players")
	local player = Players.LocalPlayer
	local button = script.Parent
	
	print("[AutoVoid]: Script successfully loaded!")
	
	-- Reference the boxes safely
	local countBox = button:FindFirstChild("VoidDropCount")
	local speedBox = button:FindFirstChild("VoidDropsSpeed")
	local delayBox = button:FindFirstChild("VoidDropDelay")
	
	local DEFAULT_COUNT = 10
	local DEFAULT_SPEED = 3000
	local DEFAULT_DELAY = 0.5
	
	local isRunning = false
	
	local COLOR_START = Color3.fromRGB(0, 200, 0)    -- Green
	local COLOR_RUNNING = Color3.fromRGB(230, 180, 0) -- Yellow
	
	button.Text = "Start"
	button.BackgroundColor3 = COLOR_START
	
	local function getSettings()
		local count = DEFAULT_COUNT
		local speed = DEFAULT_SPEED
		local dropDelay = DEFAULT_DELAY
	
		if countBox and countBox:IsA("TextBox") then
			count = tonumber(countBox.Text) or DEFAULT_COUNT
		end
		if speedBox and speedBox:IsA("TextBox") then
			speed = tonumber(speedBox.Text) or DEFAULT_SPEED
		end
		if delayBox and delayBox:IsA("TextBox") then
			dropDelay = tonumber(delayBox.Text) or DEFAULT_DELAY
		end
	
		return count, speed, dropDelay
	end
	
	-- Initialize text if empty
	if countBox and countBox:IsA("TextBox") and countBox.Text == "" then countBox.Text = tostring(DEFAULT_COUNT) end
	if speedBox and speedBox:IsA("TextBox") and speedBox.Text == "" then speedBox.Text = tostring(DEFAULT_SPEED) end
	if delayBox and delayBox:IsA("TextBox") and delayBox.Text == "" then delayBox.Text = tostring(DEFAULT_DELAY) end
	
	local function smoothMoveToVoid(speed)
		local character = player.Character or player.CharacterAdded:Wait()
		local humanoid = character:WaitForChild("Humanoid", 5)
		local rootPart = character:WaitForChild("HumanoidRootPart", 5)
	
		if character and humanoid and rootPart and humanoid.Health > 0 then
			print("[AutoVoid]: Moving down with speed " .. speed .. "...")
	
			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
	
			local targetY = -500
			while rootPart.Position.Y > targetY and humanoid.Health > 0 do
				for _, part in ipairs(character:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = false
					end
				end
				rootPart.AssemblyLinearVelocity = Vector3.new(0, -speed, 0)
				task.wait(0)
			end
	
			rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			print("[AutoVoid]: Reached target depth!")
		end
	end
	
	-- Button Click Event
	button.MouseButton1Click:Connect(function()
		print("[AutoVoid]: Click detected!")
	
		if isRunning then 
			print("[AutoVoid]: Sequence already running!")
			return 
		end
	
		isRunning = true
		button.Text = "Running"
		button.BackgroundColor3 = COLOR_RUNNING
	
		local totalCycles, currentSpeed, currentDelay = getSettings()
		print(string.format("[AutoVoid]: Settings -> Count: %d | Speed: %d | Delay: %.2fs", totalCycles, currentSpeed, currentDelay))
	
		task.spawn(function()
			local success, err = pcall(function()
				-- Single Reset Before Sequence
				print("[AutoVoid]: Resetting character once...")
				local character = player.Character
				if character then
					local humanoid = character:FindFirstChildOfClass("Humanoid")
					if humanoid then
						humanoid.Health = 0
					end
				end
	
				print("[AutoVoid]: Waiting for character to respawn...")
				player.CharacterAdded:Wait()
				task.wait(0)
	
				-- Run Sequence
				for i = 1, totalCycles do
					print("[AutoVoid]: Drop #" .. i .. " of " .. totalCycles)
					smoothMoveToVoid(currentSpeed)
	
					if i < totalCycles then
						totalCycles, currentSpeed, currentDelay = getSettings()
						print("[AutoVoid]: Waiting " .. currentDelay .. "s...")
						task.wait(currentDelay)
					end
				end
			end)
	
			if not success then
				warn("[AutoVoid Error]: " .. tostring(err))
			end
	
			print("[AutoVoid]: Sequence finished.")
			button.Text = "Start"
			button.BackgroundColor3 = COLOR_START
			isRunning = false
		end)
	end)
end
