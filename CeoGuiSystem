-- Hitbox & Immunity Logic
local isMainRunning = false
local customPlayerSizes = {}
local affectedCharacters = {}
local playerConnections = {}
local playerAddedConn = nil

local function hexToColor3(hex)
	hex = hex:gsub("#", "")
	if #hex ~= 6 then 
		return Color3.fromRGB(255, 0, 0)
	end
	local r = tonumber(hex:sub(1, 2), 16) or 255
	local g = tonumber(hex:sub(3, 4), 16) or 255
	local b = tonumber(hex:sub(5, 6), 16) or 255
	return Color3.fromRGB(r, g, b)
end

local function applyHitboxToCharacter(character, size, outlineColor)
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart or character == player.Character then return end

	if not affectedCharacters[character] then
		affectedCharacters[character] = {
			RootPart = rootPart,
			OriginalSize = rootPart.Size,
			OriginalCanCollide = rootPart.CanCollide,
		}
	end

	rootPart.Size = Vector3.new(size, size, size)
	rootPart.CanCollide = false
	rootPart.Transparency = 1

	local selectionBox = rootPart:FindFirstChild("HitboxOutline")
	if not selectionBox then
		selectionBox = Instance.new("SelectionBox")
		selectionBox.Name = "HitboxOutline"
		selectionBox.LineThickness = 0.05
		selectionBox.Adornee = rootPart
		selectionBox.Parent = rootPart
	end
	selectionBox.Color3 = outlineColor
end

local function resetCharacterHitbox(character)
	local data = affectedCharacters[character]
	if data and data.RootPart and data.RootPart.Parent then
		data.RootPart.Size = data.OriginalSize
		data.RootPart.CanCollide = data.OriginalCanCollide
		local outline = data.RootPart:FindFirstChild("HitboxOutline")
		if outline then outline:Destroy() end
		affectedCharacters[character] = nil
	end
end

local function updateHitboxes()
	local mainSize = tonumber(SizeInput.Text) or 15
	local mainColor = hexToColor3(ColorInput.Text)

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			if customPlayerSizes[p] then
				local customSize = customPlayerSizes[p]
				if customSize <= 2 then
					resetCharacterHitbox(p.Character)
				else
					applyHitboxToCharacter(p.Character, customSize, Color3.fromRGB(0, 255, 255))
				end
			elseif isMainRunning then
				applyHitboxToCharacter(p.Character, mainSize, mainColor)
			else
				resetCharacterHitbox(p.Character)
			end
		end
	end
end

local function setupConnections()
	if playerAddedConn then return end
	playerAddedConn = Players.PlayerAdded:Connect(function(p)
		if p ~= player then
			playerConnections[p] = p.CharacterAdded:Connect(function(char)
				task.wait(0.5)
				updateHitboxes()
			end)
		end
	end)
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and not playerConnections[p] then
			playerConnections[p] = p.CharacterAdded:Connect(function(char)
				task.wait(0.5)
				updateHitboxes()
			end)
		end
	end
end

